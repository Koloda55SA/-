rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Админы. Создание первого админа — через Firebase Console.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Водители: админ — полный доступ; водитель — только чтение собственного документа.
    // Doc ID водителя = его Firebase Auth UID, поэтому достаточно сравнить с request.auth.uid.
    match /drivers/{driverId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Путевые листы:
    //   - чтение: админ или владелец (по authUid в документе)
    //   - список: админ — без ограничений; водитель — только свои документы.
    //     Условие resource.data.authUid == request.auth.uid заставляет Firestore
    //     отклонить любой запрос, который не отфильтрован по своему authUid
    //     (правила проверяют, что выборка гарантированно вернёт только свои
    //     документы — иначе весь запрос падает).
    //   - создание: только сам водитель и только для своего authUid
    //   - обновление: админ или владелец (например, закрытие смены)
    //   - удаление: только админ
    match /waybills/{waybillId} {
      allow get: if isAdmin() ||
                    (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow list: if isAdmin() ||
                    (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(
                         ['driverId', 'authUid', 'waybillNumber', 'date', 'driverName']
                       ) &&
                       request.resource.data.authUid == request.auth.uid;
      allow update: if isAdmin() ||
                       (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Настройки компании. Читать может любой авторизованный (нужно мобильному
    // приложению), писать — только админ.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Запросы на сброс пароля (создаёт админ; обработает Cloud Function).
    // ВАЖНО: запрещаем хранить открытый пароль в документе.
    match /passwordResets/{requestId} {
      allow create: if isAdmin() &&
                       !('newPassword' in request.resource.data) &&
                       !('password' in request.resource.data);
      allow read, list: if isAdmin();
    }

    // Запросы на удаление аккаунта водителя (создаёт сам водитель или админ)
    match /deletionRequests/{requestId} {
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // Запросы на удаление аккаунта (создаёт админ; обрабатывает Cloud Function)
    match /driverDeletions/{requestId} {
      allow create: if isAdmin();
      allow read, list: if isAdmin();
    }

    // По умолчанию всё закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
