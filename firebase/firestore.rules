rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Админы. Создание первого админа — через Firebase Console.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Водители: админ — полный доступ; водитель — только чтение собственного документа.
    // Doc ID водителя = его Firebase Auth UID, поэтому достаточно сравнить с request.auth.uid.
    match /drivers/{driverId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // CRM-заметки по водителю — только админ.
      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // Техподдержка: диалог водителя с админом.
    // Doc ID диалога = Auth UID водителя. Водитель видит/пишет только свой диалог,
    // админ — все диалоги. Сообщения хранятся в подколлекции messages.
    match /supportChats/{driverId} {
      allow get, create, update: if isAdmin() ||
                       (isAuthenticated() && request.auth.uid == driverId);
      allow list: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() ||
                       (isAuthenticated() && request.auth.uid == driverId);
        // Историю переписки не редактируем и не удаляем.
        allow update, delete: if false;
      }
    }

    // Оплаты водителей (бухгалтерия). Полностью на стороне админа.
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Путевые листы:
    //   - чтение: админ или владелец (по authUid в документе)
    //   - список: админ — без ограничений; водитель — только запрос с фильтром
    //     по своему authUid (rules не выполнят запрос, если фильтра нет, потому
    //     что иначе попадутся документы чужих водителей)
    //   - создание: только сам водитель и только для своего authUid
    //   - обновление: админ или владелец (например, закрытие смены)
    //   - удаление: только админ
    match /waybills/{waybillId} {
      // get разрешён всем: QR-код на печатном ЭПЛ ведёт на публичную страницу
      // просмотра по id документа (id случайный, перебор невозможен; те же данные
      // уже напечатаны на самом листе).
      allow get: if true;
      allow list: if isAdmin() ||
                    (isAuthenticated() && request.query.limit <= 100);
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(
                         ['driverId', 'authUid', 'waybillNumber', 'date', 'driverName']
                       ) &&
                       request.resource.data.authUid == request.auth.uid;
      allow update: if isAdmin() ||
                       (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Настройки компании. Читать может любой авторизованный (нужно мобильному
    // приложению), писать — только админ.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Запросы на сброс пароля (создаёт админ; обработает Cloud Function).
    // ВАЖНО: запрещаем хранить открытый пароль в документе.
    match /passwordResets/{requestId} {
      allow create: if isAdmin() &&
                       !('newPassword' in request.resource.data) &&
                       !('password' in request.resource.data);
      allow read, list: if isAdmin();
    }

    // Запросы на удаление аккаунта водителя (создаёт сам водитель или админ)
    match /deletionRequests/{requestId} {
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
    }

    // Запросы на удаление аккаунта (создаёт админ; обрабатывает Cloud Function)
    match /driverDeletions/{requestId} {
      allow create: if isAdmin();
      allow read, list: if isAdmin();
    }

    // Счётчик выпущенных ЭПЛ для контроля лимита (60 на квоту).
    // Doc ID = Firebase Auth UID водителя. Водитель ведёт свой счётчик,
    // админ может читать для статистики.
    match /driverCounters/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Заявки на дополнительные ЭПЛ (+60). Создаёт водитель для себя,
    // читает свои заявки; админ видит все и подтверждает/отклоняет (update).
    match /quotaRequests/{requestId} {
      allow create: if isAuthenticated() &&
                       request.resource.data.authUid == request.auth.uid &&
                       request.resource.data.status == 'pending';
      allow get: if isAdmin() ||
                    (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow list: if isAdmin() ||
                    (isAuthenticated() && request.query.limit <= 100);
      allow update: if isAdmin();
    }

    // По умолчанию всё закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
